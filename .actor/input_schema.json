{
    "$schema": "https://apify.com/schemas/v1/input.ide.json",
    "title": "Wikipedia Election Scrapper",
    "description": "Looks up the current U.S. Senate general election candidates for the state you select, sourced live from Wikipedia. This version is fixed to the 2026 election cycle; configurable year and office inputs are planned for a future release.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "office": {
            "title": "Office",
            "type": "string",
            "description": "Office of the election (Senate, Govenor, Presidential)",
            "editor": "select",
            "prefill": "S",
            "enum": [
                "S",
                "G",
                "P"
            ],
            "enumTitles": [
                "Senate",
                "Govenor",
                "Presidential"
            ]
        },
        "state": {
            "title": "State",
            "type": "string",
            "description": "US state of the election",
            "editor": "select",
            "prefill": "MI",
            "enum": [
                "AL",
                "AK",
                "AZ",
                "AR",
                "CA",
                "CO",
                "CT",
                "DE",
                "FL",
                "GA",
                "HI",
                "ID",
                "IL",
                "IN",
                "IA",
                "KS",
                "KY",
                "LA",
                "ME",
                "MD",
                "MA",
                "MI",
                "MN",
                "MS",
                "MO",
                "MT",
                "NE",
                "NV",
                "NH",
                "NJ",
                "NM",
                "NY",
                "NC",
                "ND",
                "OH",
                "OK",
                "OR",
                "PA",
                "RI",
                "SC",
                "SD",
                "TN",
                "TX",
                "UT",
                "VT",
                "VA",
                "WA",
                "WV",
                "WI",
                "WY"
            ],
            "enumTitles": [
                "Alabama",
                "Alaska",
                "Arizona",
                "Arkansas",
                "California",
                "Colorado",
                "Connecticut",
                "Delaware",
                "Florida",
                "Georgia",
                "Hawaii",
                "Idaho",
                "Illinois",
                "Indiana",
                "Iowa",
                "Kansas",
                "Kentucky",
